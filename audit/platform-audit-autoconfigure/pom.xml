<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-audit-autoconfigure</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: Audit :: Auto Configuration</name>
  <description>
    Wires the async Auditor over the AuditSink selected by a messaging -> jdbc -> log degradation chain,
    enforces @Audited via a plain AOP advisor (actor from the security capability's CurrentUserAccessor
    when present, outcome from the method's return/throw), and publishes audit events to messaging when
    the messaging capability is on the classpath.
  </description>

  <dependencies>
    <!-- autoconfigure -> same-capability api/spi (+ core-api for CapabilityDescriptor). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-audit-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-audit-spi</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-core-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- Optional same-capability sinks: selected by @ConditionalOnClass on the sink types. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-audit-log</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-audit-jdbc</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <!-- Other cap's api, guarded by @ConditionalOnClass: resolve the actor from the current user.
         (The messaging sink is a separate module, platform-audit-messaging-autoconfigure, so this
         module stays within the autoconfigure fan-out ceiling — decision D53.) -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-security-api</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <!-- spring-jdbc (JdbcTemplate) + Flyway for the jdbc sink's migration wiring; both optional. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- Generates config metadata for dc.platform.audit.* from the properties record. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Runs PlatformArchRules over this module (ArchConstitutionTest). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ContextRunner + Mockito + Awaitility + assertions. The sinks, messaging-api, security-api,
         spring-jdbc, Flyway and H2 are on the test classpath via the optional deps above + H2 below. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
