<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>dc-platform</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>platform-build-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>DC Platform :: Build Maven Plugin</name>
  <description>
    Scaffolding and reactor hygiene: new-module generates a constitution-compliant module skeleton
    (POM, packages, ArchConstitutionTest, autoconfigure canon) and registers it in the root reactor
    and platform-bom; check-bom fails when a publishable reactor artifact is missing from the BOM.
    Parent is the root aggregator for the same cycle-avoidance reason as platform-build-tools (D4).
  </description>

  <properties>
    <!-- Versions are legal in build/ modules (the no-version rule exempts them). -->
    <maven.version>3.9.9</maven.version>
    <maven-plugin-tools.version>3.15.2</maven-plugin-tools.version> <!-- 3.15.1 cannot read Java 25 class files -->
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <!-- upgrade-check parses spring-configuration-metadata.json deprecation entries from platform jars. -->
    <jackson.version>2.18.2</jackson.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin-tools.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Source of the ArchConstitutionTest template the scaffolder copies into new modules. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- upgrade-check reads Spring Boot configuration-metadata deprecation entries out of platform jars. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin-tools.version}</version>
      </plugin>
      <!-- DoD coverage gate; build modules wire it themselves (parent is the bare aggregator). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <configuration>
          <!-- UpgradeCheckMojo is Maven/Aether resolution glue (resolve target BOM + jars); its logic
               lives in the fully-tested internal/* helpers. Same rationale as the Containers exclusion
               in platform-test-api: bodies that need real resolution can't run in the offline suite. -->
          <excludes>
            <exclude>**/UpgradeCheckMojo.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
