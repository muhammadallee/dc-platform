<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>dc-platform</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>platform-build-tools</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: Build Tools</name>
  <description>
    Gates-as-code: the PlatformLayerRule enforcer rule (dependency constitution), the
    PlatformArchRules ArchUnit library, the shared checkstyle configuration, and the
    ArchConstitutionTest template. Parent is the ROOT AGGREGATOR, not platform-parent: the gates in
    platform-parent depend on this artifact, so inheriting them here would be a cycle (decision D4).
  </description>

  <properties>
    <!-- This artifact is loaded INSIDE Maven's own JVM (enforcer rule discovery uses Maven's
         embedded sisu bytecode scanner, which cannot read Java 25 class files on Maven 3.9.x).
         Compile to 21 so the rule stays discoverable; it still runs fine on the Java 25 toolchain. -->
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Versions are legal in build/ modules (the no-version rule exempts them). -->
    <maven.version>3.9.9</maven.version>
    <enforcer-api.version>3.6.3</enforcer-api.version> <!-- keep in lockstep with platform-parent's enforcer plugin -->
    <!-- archunit.version comes from the root aggregator (shared with platform-dependencies). -->
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <apiguardian.version>1.1.2</apiguardian.version> <!-- keep in lockstep with platform-dependencies -->
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Test-only convenience: versions for the whitelist fixtures (spring-web, jakarta.validation)
           come from Boot's BOM instead of hand-pinned literals. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- New-style (3.2.1+) enforcer rule API; the plugin provides it at run time. -->
    <dependency>
      <groupId>org.apache.maven.enforcer</groupId>
      <artifactId>enforcer-api</artifactId>
      <version>${enforcer-api.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- MavenProject/Model for the rule; Maven core is always present in the enforcer runtime. -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.inject</groupId>
      <artifactId>javax.inject</artifactId>
      <version>1</version>
      <scope>provided</scope>
    </dependency>
    <!-- Compile scope on purpose: consumer modules get ArchUnit transitively for their
         ArchConstitutionTest (this artifact is a test-scope dependency there). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: lets the ArchUnit-rule fixtures compile against the Spring annotations the
         rules match by NAME (main code stays Spring-free). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <version>${spring-boot.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: apiguardian on the test classpath so the @API-status rule fixtures below can
         actually carry @API(status=...) for the rule to read (main code stays annotation-free). -->
    <dependency>
      <groupId>org.apiguardian</groupId>
      <artifactId>apiguardian-api</artifactId>
      <version>${apiguardian.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: fixtures proving the per-capability api whitelist admits ProblemDetail for
         errors / jakarta.validation for validation, and ONLY there. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Generates the sisu index the enforcer plugin needs to discover @Named rules. -->
      <plugin>
        <groupId>org.eclipse.sisu</groupId>
        <artifactId>sisu-maven-plugin</artifactId>
        <version>1.0.1</version> <!-- 0.9.x cannot read Java 25 class files -->
        <executions>
          <execution>
            <id>index</id>
            <goals><goal>main-index</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- DoD coverage gate; build modules wire it themselves (parent is the bare aggregator). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
