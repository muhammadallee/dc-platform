<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>dc-platform</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>platform-dependencies</artifactId>
  <packaging>pom</packaging>

  <name>DC Platform :: Dependencies (third-party BOM)</name>
  <description>
    The ONLY place third-party versions are declared (constitution: no version tags outside build/).
    Imports spring-boot-dependencies, then pins only what Boot does not manage.
  </description>

  <dependencyManagement>
    <dependencies>
      <!-- Phase 5, THE one sanctioned override (first import wins; decision D17): Boot 4.1.0
           manages io.prometheus at 1.5.1 while its own micrometer 1.17 declares 1.7.0, which
           fails the requireUpperBoundDeps gate. Aligned to micrometer's declared version.
           Re-check on every Boot bump and DELETE once Boot catches up. -->
      <dependency>
        <groupId>io.prometheus</groupId>
        <artifactId>prometheus-metrics-bom</artifactId>
        <version>1.7.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Boot's curated universe next; everything below only ADDS, never overrides. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Phase 2: ArchUnit for every module's ArchConstitutionTest (Boot does not manage it). -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>

      <!-- Phase 3: classgraph backs core-api's executable public-type-count cap (test scope there).
           Boot's BOM does not manage it. jspecify needs NO pin: Boot 4.x manages 1.0.0. -->
      <dependency>
        <groupId>io.github.classgraph</groupId>
        <artifactId>classgraph</artifactId>
        <version>4.8.184</version>
      </dependency>

      <!-- Phase 4: JSON log encoder behind platform-logging (Boot does not manage it). -->
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>8.1</version>
      </dependency>

      <!-- Phase 5: springdoc 3.x is the Boot-4-compatible line (springdoc's own compatibility
           matrix: 3.x.x <-> spring-boot 4.x.x); Boot does not manage it. -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>3.0.3</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>3.0.3</version>
      </dependency>

      <!-- Phase 6: MockWebServer backs platform-restclient-autoconfigure's header/timeout/error
           mapping tests (Boot does not manage it). -->
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>mockwebserver</artifactId>
        <version>4.12.0</version>
      </dependency>

      <!-- Phase 7, another sanctioned override (decision D28): Boot 4.1.0 manages spring-amqp's
           com.rabbitmq:amqp-client at 5.30.0, but testcontainers-rabbitmq (testcontainers-bom
           2.0.5) pulls 5.31.0 transitively, failing requireUpperBoundDeps. Aligned to the higher
           version. Re-check on every Boot/testcontainers bump and DELETE once they converge. -->
      <dependency>
        <groupId>com.rabbitmq</groupId>
        <artifactId>amqp-client</artifactId>
        <version>5.31.0</version>
      </dependency>

      <!-- Phase 9: Resilience4j for the resilience capability. The 2.4.0 line is the first to ship
           the spring-boot4 integration module (resilience4j-spring-boot4); its BOM aligns retry,
           circuitbreaker, timelimiter and micrometer. Boot does not manage Resilience4j. -->
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>2.4.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- The 2.4.0 BOM manages every Resilience4j module EXCEPT the new spring-boot4 integration
           (it still lists only spring-boot3), so the Boot-4 starter's version is pinned here. Keep
           in lockstep with the BOM version above; drop once the BOM lists spring-boot4. -->
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot4</artifactId>
        <version>2.4.0</version>
      </dependency>

      <!-- Pins are added by the phase that introduces the dependency. Do not pre-pin speculatively.
           awaitility is managed by Boot's BOM, so no pin is needed for the async scheduling/idempotency
           tests. -->

      <!-- Phase 10: AWS SDK v2 for the S3 storage provider. Imported as a BOM so the s3 module and its
           transitive SDK artifacts (auth, http-client, regions) stay version-aligned; the storage-s3
           impl then declares s3 without a version. Boot does not manage the AWS SDK. -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>2.28.16</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Phase 10: OpenFeature SDK for the openfeature flag provider — the adapter seam through which
           enterprise providers (LaunchDarkly, Flagsmith, …) plug in downstream. Boot does not manage it. -->
      <dependency>
        <groupId>dev.openfeature</groupId>
        <artifactId>sdk</artifactId>
        <version>1.9.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Published as a standalone BOM: flatten strips the parent so consumers outside the
           reactor can import it without resolving the aggregator. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>bom</flattenMode>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
