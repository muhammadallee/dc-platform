<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>dc-platform</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>platform-parent</artifactId>
  <packaging>pom</packaging>

  <name>DC Platform :: Parent (platform modules)</name>
  <description>
    Build conventions for the platform's OWN modules. Application teams never use this parent;
    they use platform-service-parent. Custom gates (checkstyle, PlatformLayerRule, ArchUnit,
    japicmp) are wired here in phase 2.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>ae.gov.dubaicustoms.platform</groupId>
        <artifactId>platform-dependencies</artifactId>
        <version>${revision}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Managed so every module can declare its ArchConstitutionTest dependency version-less. -->
      <dependency>
        <groupId>ae.gov.dubaicustoms.platform</groupId>
        <artifactId>platform-build-tools</artifactId>
        <version>${revision}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Test toolkit every platform module gets for free (versions from Boot's BOM). -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Implementation-Version in every platform jar manifest: the observability common tag
             platform.version reads it at runtime (phase-05 spec: version from the jar manifest).
             Version pinned so the explicit <plugins> binding below resolves to the SAME plugin
             instance as this managed configuration (an unversioned pair does not reliably merge). -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.0</version>
          <configuration>
            <archive>
              <manifest>
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <!-- Binary compatibility gate. Fully configured, but platform.japicmp.skip=true keeps it
             inert until the first release exists to compare against (phase 4 flips the property
             after tag 0.1.0). api/spi modules opt into build-breaking via platform.japicmp.breakBuild. -->
        <plugin>
          <groupId>com.github.siom79.japicmp</groupId>
          <artifactId>japicmp-maven-plugin</artifactId>
          <version>0.26.1</version> <!-- older javassist cannot read Java 25 class files -->
          <configuration>
            <skip>${platform.japicmp.skip}</skip>
            <oldVersion>
              <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>${project.artifactId}</artifactId>
                <version>RELEASE</version>
                <type>jar</type>
              </dependency>
            </oldVersion>
            <parameter>
              <onlyModified>true</onlyModified>
              <excludes>
                <exclude>*.internal.*</exclude>
              </excludes>
              <breakBuildOnBinaryIncompatibleModifications>${platform.japicmp.breakBuild}</breakBuildOnBinaryIncompatibleModifications>
              <!-- First build after a rename/new module has no baseline: report, don't fail. -->
              <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
            </parameter>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Explicit binding (not just pluginManagement): the default-jar lifecycle binding does
           not reliably pick up unversioned pluginManagement configuration across all Maven/module
           combinations in this reactor; declaring it here guarantees the manifest entry lands. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>25</release>
          <parameters>true</parameters> <!-- Spring binds constructor params by name -->
        </configuration>
      </plugin>

      <!-- JUnit tag 'docker' is excluded by default so the reactor builds with no Docker.
           The 'docker' profile below clears the exclusion. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${platform.test.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <excludedGroups>${platform.test.excludedGroups}</excludedGroups>
        </configuration>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <configuration>
          <!-- internal packages ARE counted (phase-02 spec); only generated code, autoconfigure
               classes (covered by the ContextRunner matrix, mostly declarative) and config-props
               records are excluded from the ratio. -->
          <excludes>
            <exclude>**/generated/**</exclude>
            <exclude>**/*AutoConfiguration.class</exclude>
            <exclude>**/*AutoConfiguration$*.class</exclude>
            <exclude>**/*Properties.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <goals><goal>check</goal></goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version> <!-- 3.5.0's container cannot load Java 25-compiled custom rules -->
        <dependencies>
          <!-- Brings the custom platformLayerRule into the enforcer's runtime. -->
          <dependency>
            <groupId>ae.gov.dubaicustoms.platform</groupId>
            <artifactId>platform-build-tools</artifactId>
            <version>${revision}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>platform-enforcer</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
                <dependencyConvergence/> <!-- exceptions require a decision-log entry, not an exclusion -->
                <requireUpperBoundDeps/>
                <!-- The dependency constitution: layer matrix, fan-out ceilings, version-tag ban. -->
                <platformLayerRule/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Shared checkstyle gate; config ships inside platform-build-tools. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <dependencies>
          <dependency>
            <groupId>ae.gov.dubaicustoms.platform</groupId>
            <artifactId>platform-build-tools</artifactId>
            <version>${revision}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>checkstyle/platform-checkstyle.xml</configLocation>
          <failOnViolation>true</failOnViolation>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle</id>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>japicmp</id>
            <phase>verify</phase>
            <goals><goal>cmp</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <properties>
    <platform.test.excludedGroups>docker</platform.test.excludedGroups>
    <!-- Active since 0.1.0 exists (phase-4 milestone M1): compares against the latest release in
         the repository; api/spi modules set breakBuild=true so ONLY contract artifacts break. -->
    <platform.japicmp.skip>false</platform.japicmp.skip>
    <platform.japicmp.breakBuild>false</platform.japicmp.breakBuild>
  </properties>

  <profiles>
    <!-- mvn -Pdocker verify : also runs @Tag("docker") suites (Testcontainers manages containers). -->
    <profile>
      <id>docker</id>
      <properties>
        <platform.test.excludedGroups/>
      </properties>
    </profile>
  </profiles>
</project>
