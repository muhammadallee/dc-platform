<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-cache-autoconfigure</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: Cache :: Auto Configuration</name>
  <description>
    Auto-configuration for the cache capability: a default CacheKeyConvention (app-name-prefixed,
    ':'-joined), per-cache TTL/size from dc.platform.cache.caches.*, a Caffeine CacheManager when
    Caffeine is on the classpath, and a Redis CacheManager (String keys, JSON values) when Spring
    Data Redis is on the classpath. Ordered before Boot's CacheAutoConfiguration so the platform
    per-cache policy wins; user-defined CacheManagers always take precedence.
  </description>

  <dependencies>
    <!-- autoconfigure -> same-capability api (+ core-api for CapabilityDescriptor). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-cache-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-core-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- Boot's cache autoconfigure: CacheAutoConfiguration (for `before` ordering). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-cache</artifactId>
    </dependency>
    <!-- CaffeineCacheManager lives in spring-context-support; guarded by @ConditionalOnClass. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context-support</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Caffeine provider: default in-memory manager; guarded by @ConditionalOnClass. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Redis provider: RedisCacheManager + serializers; guarded by @ConditionalOnClass. -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Generates config metadata from the properties record at compile time. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Runs PlatformArchRules over this module (ArchConstitutionTest). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Caffeine and spring-context-support are declared optional above; being optional they are
         still on THIS module's own test classpath, so the docker-free Caffeine TTL/size tests need
         no extra test-scope declaration. -->
    <!-- @Tag("docker") Redis round-trip test only: real Redis via Testcontainers. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
