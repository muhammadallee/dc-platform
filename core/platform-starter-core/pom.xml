<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-starter-core</artifactId>
  <!-- Starters contain no code (CLAUDE.md rule 4): jar packaging like Boot starters, empty jar. -->
  <packaging>jar</packaging>

  <name>DC Platform :: Core :: Starter</name>
  <description>
    The smallest useful chassis: correlation-id propagation, the platform exception model, and the
    startup capability banner. Every DC platform service starts here.
  </description>

  <!-- Included automatically by platform-service-parent? NO: apps declare it; the archetype
       writes it. Rationale: explicit dependencies (ADR-007) - the parent stays inheritance-light
       and a service's POM shows exactly which capabilities it uses. -->
  <dependencies>
    <!-- starter -> same-capability autoconfigure + named impl(s) (CLAUDE.md rule 5).
         core-api arrives transitively through the autoconfigure module; a direct dependency here
         is rejected by the platformLayerRule (the constitution wins over the phase-03 wording). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-core-autoconfigure</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- Boot's base starter: logging, SnakeYAML-free config binding, annotations. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
</project>
