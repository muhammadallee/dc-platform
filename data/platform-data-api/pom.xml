<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-data-api</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: Data :: API</name>
  <description>
    Tech-neutral persistence value objects and conventions shared by every DC platform service:
    the Money value type (with its attribute-converter storage contract), the EntityId typed-id
    helper, and the PersistenceConventions constants (column lengths, audit column names). Carries
    no JPA/Hibernate types so it stays usable from tech-neutral domain code (CLAUDE.md rule 5).
  </description>

  <!-- Contract artifact: binary-incompatible changes must break the build once a release
       baseline exists (platform-parent wires japicmp; the skip flag flips after 0.1.0). -->
  <properties>
    <platform.japicmp.breakBuild>true</platform.japicmp.breakBuild>
  </properties>

  <dependencies>
    <!-- api -> core-api only (CLAUDE.md rule 5): @PlatformApi lives there. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-core-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- Runs PlatformArchRules over this module (ArchConstitutionTest). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
