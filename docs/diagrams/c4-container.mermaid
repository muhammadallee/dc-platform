flowchart TB
  dev["Developer<br>[Person]<br>builds services on the chassis"]
  pteam["Platform Team<br>[Person]<br>owns capabilities and trains"]

  subgraph svc["A Service - Software System built on the platform"]
    app["Spring Boot App<br>[Container: JVM]<br>Controller, Service, application.yml"]
    subgraph plat["DC Platform - library containers inside the app"]
      st["Capability Starters<br>[POM-only composition]"]
      ac["Auto-Configurations<br>[conditional beans, kill switches, back-off]"]
      apispi["APIs and SPIs<br>[stable contracts, SemVer + japicmp]"]
      impl["Providers<br>[kafka, rabbit, jpa, redis, s3, vault, fs, inmemory]"]
    end
  end

  idp["Identity Provider<br>[OIDC issuer]"]
  broker[("Kafka / RabbitMQ")]
  db[("PostgreSQL")]
  cache[("Redis")]
  obj[("Object Storage - S3")]
  vault["Vault<br>[secrets]"]
  obs["Observability Backend<br>[OTLP / Prometheus]"]

  dev -->|adds starters, writes code| app
  pteam -->|publishes release train via BOM| plat
  app --> st --> ac --> impl
  ac --> apispi
  impl --> apispi
  app -->|validates JWT| idp
  impl --> broker
  impl --> db
  impl --> cache
  impl --> obj
  impl --> vault
  app -->|metrics, traces, structured logs| obs
