flowchart LR
  appc["Application code"]
  subgraph api["messaging-api"]
    pub["EventPublisher"]
    hnd["EventHandler annotation"]
    env["EventEnvelope"]
  end
  subgraph auto["messaging-autoconfigure"]
    dpub["DefaultEventPublisher<br>adds correlation, observation"]
    reg["EventHandlerRegistrar<br>retry and DLQ wrapper, metrics"]
    ser["Jackson serializer - default, replaceable"]
    props["MessagingProperties<br>dc.platform.messaging.*"]
  end
  subgraph spi["messaging-spi"]
    tr["EventTransport"]
    srz["EventSerializer"]
  end
  subgraph prov["providers - exactly one active"]
    inm["inmemory - local default"]
    kfk["kafka"]
    rbt["rabbit"]
  end
  appc -->|publish| pub
  appc -->|annotates methods| hnd
  pub --> env
  dpub -. implements .-> pub
  reg -. discovers .-> hnd
  ser -. implements .-> srz
  dpub --> srz
  dpub --> tr
  reg --> tr
  props --> dpub
  props --> reg
  inm -. implements .-> tr
  kfk -. implements .-> tr
  rbt -. implements .-> tr
  kfk --> kb[("Kafka")]
  rbt --> rb[("RabbitMQ")]
