<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-starter-errors</artifactId>
  <!-- Starters contain no code (CLAUDE.md rule 4): jar packaging like Boot starters, empty jar. -->
  <packaging>jar</packaging>

  <name>DC Platform :: Errors :: Starter</name>
  <description>
    RFC-9457 problem responses for every DC platform service: business exceptions with stable
    error codes mapped to ProblemDetail with code, correlationId, and timestamp extensions.
  </description>

  <dependencies>
    <!-- starter -> same-capability autoconfigure (CLAUDE.md rule 5); errors-api arrives
         transitively. No web starter here: the consuming service picks its own web stack and
         the advice backs off outside servlet apps anyway (mirrors starter-core, decision D10). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-errors-autoconfigure</artifactId>
      <version>${revision}</version>
    </dependency>
  </dependencies>
</project>
