<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-service-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-service-parent</relativePath>
  </parent>

  <groupId>ae.gov.dubaicustoms.platform.examples</groupId>
  <artifactId>example-golden-path</artifactId>

  <name>example-golden-path</name>
  <description>The canonical reference service: REST + validation + security + OpenAPI + observability
    + JPA (H2) + messaging (in-memory) + cache + resilience + audit over a small "orders" domain,
    heavily commented and tested through the platform test slices.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!-- The golden-path chassis. One starter per cross-cutting concern; versions come from the BOM. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-errors</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-logging</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-openapi</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-messaging-inmemory</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-cache-caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-resilience</artifactId>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-audit</artifactId>
    </dependency>
    <!-- The app owns its web stack; the platform layers cross-cutting behavior on top of it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Local persistence: H2 in dev/test. A `pg` profile points at PostgreSQL for prod-sim runs. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Platform test kit: @PlatformWebTest / @PlatformDataTest / @PlatformMessagingTest / @PlatformTest,
         TestTokens, TestEventTransport, assertThatProblem. Brings MockMvc test support transitively. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- prod-sim: swap H2 for PostgreSQL. Requires a running PG (docker compose up postgres); the
         platform reads spring.datasource.* exactly as in prod. Kept out of the default build so the
         reactor never needs a database. -->
    <profile>
      <id>pg</id>
      <dependencies>
        <dependency>
          <groupId>org.postgresql</groupId>
          <artifactId>postgresql</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
