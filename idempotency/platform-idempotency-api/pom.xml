<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-idempotency-api</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: Idempotency :: API</name>
  <description>
    The @Idempotent annotation and the IdempotencyStore contract (SPI-lite): mark a method idempotent
    by a SpEL-derived key, and the platform rejects duplicate invocations within a TTL. No provider
    types leak here.
  </description>

  <!-- Contract artifact: binary-incompatible changes must break the build once a release
       baseline exists (platform-parent wires japicmp; the skip flag flips after 0.1.0). -->
  <properties>
    <platform.japicmp.breakBuild>true</platform.japicmp.breakBuild>
  </properties>

  <dependencies>
    <!-- Runs PlatformArchRules over this module (ArchConstitutionTest). The contract itself needs no
         platform dependency: @Idempotent and IdempotencyStore use only jdk types. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
