<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-starter-logging</artifactId>
  <!-- Starters contain no code (CLAUDE.md rule 4): jar packaging like Boot starters, empty jar. -->
  <packaging>jar</packaging>

  <name>DC Platform :: Logging :: Starter</name>
  <description>
    Structured JSON logs for every DC platform service: Spring Boot's structured logging with service and
    correlation fields and the platform's masking, console fallback on the local profile.
  </description>

  <dependencies>
    <!-- starter -> same-capability autoconfigure (CLAUDE.md rule 5). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-logging-autoconfigure</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The named runtime: Boot's Logback logging, whose structured JSON the platform configures (D141). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-logging</artifactId>
    </dependency>
  </dependencies>
</project>
