<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-messaging-test</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: Messaging :: Test Support</name>
  <description>
    TestEventTransport (records sent messages, manual deliver(...) for simulating inbound events),
    AssertJ-style messaging assertions, and @AutoConfigureTestTransport for wiring it as the
    EventTransport bean in a test's Spring context.
  </description>

  <dependencies>
    <!-- test-support -> same-capability spi/api (never starters, CLAUDE.md rule 5). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-messaging-spi</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-messaging-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- @AutoConfigureTestTransport wires TestEventTransport via a plain @Configuration/@Import. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!-- The whole point of this module: AssertJ-style assertions over sent events. -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <!-- Runs PlatformArchRules over this module (ArchConstitutionTest). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
