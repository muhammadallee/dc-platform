<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-starter-messaging-kafka</artifactId>
  <!-- Starters contain no code (CLAUDE.md rule 4): jar packaging like Boot starters, empty jar. -->
  <packaging>jar</packaging>

  <name>DC Platform :: Messaging :: Starter (Kafka)</name>
  <description>
    Kafka-backed messaging transport, built from spring.kafka.* configuration. Publish with
    EventPublisher, handle with @EventHandler; /actuator/platform reports messaging[ACTIVE kafka].
    EXPERIMENTAL: covered by Testcontainers round-trip tests, but not part of the supported golden
    path — no example uses it, it is absent from the smoke matrix, and platform infrastructure does
    not yet provide Kafka (RabbitMQ is the supported broker). Pin deliberately; expect it to firm up
    in a later train.
  </description>

  <dependencies>
    <!-- starter -> same-capability autoconfigure + named impl (CLAUDE.md rule 5). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-messaging-autoconfigure</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-messaging-kafka</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The autoconfigure module's default JSON EventSerializer needs Jackson; it's optional
         there (a consumer supplying their own EventSerializer shouldn't be forced to add it), but
         the starter's whole point is a working zero-config default, so it's required here. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
