<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-starter-openapi</artifactId>
  <!-- Starters contain no code (CLAUDE.md rule 4): jar packaging like Boot starters, empty jar. -->
  <packaging>jar</packaging>

  <name>DC Platform :: OpenAPI :: Starter</name>
  <description>
    OpenAPI documentation for every DC platform service: the platform OpenAPI bean and
    ProblemDetail-aware customizer, plus springdoc's webmvc UI (/v3/api-docs, /swagger-ui.html).
  </description>

  <dependencies>
    <!-- starter -> same-capability autoconfigure (CLAUDE.md rule 5). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-openapi-autoconfigure</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The engine + UI (spec: springdoc-openapi-starter-webmvc-ui): the autoconfigure module
         stays optional-dependent on the api artifact only; the starter is where the UI choice
         is made (mirrors validation's spring-boot-starter-validation pattern). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
  </dependencies>
</project>
