<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ae.gov.dubaicustoms.platform</groupId>
  <artifactId>dc-platform</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>DC Platform (aggregator)</name>
  <description>Enterprise Spring Boot chassis - reactor aggregator. Not published as a dependency.</description>

  <properties>
    <!-- Single train version for ALL platform artifacts (ADR-005). Override at release time:
         mvn -Drevision=1.0.0 ... The flatten plugin resolves it in published POMs. -->
    <revision>0.2.0-SNAPSHOT</revision>

    <!-- The one place the Spring Boot line is chosen. Bump here to move the whole platform.
         Boot 4.x baseline per decision D6 (docs/decisions/decision-log.md). -->
    <spring-boot.version>4.1.0</spring-boot.version>

    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Reproducible builds: fixed timestamp in archives. Update once per release train. -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

    <!-- Plugin/library versions used by more than one POM in build/ live here so they can't drift. -->
    <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version> <!-- 0.8.14+ required for Java 25 class files -->
    <archunit.version>1.4.2</archunit.version>
  </properties>

  <modules>
    <!-- Order matters only for readability; Maven computes the real order from dependencies. -->
    <module>build/platform-dependencies</module>
    <module>build/platform-parent</module>
    <module>build/platform-bom</module>
    <module>build/platform-service-parent</module>
    <module>build/platform-build-tools</module>
    <module>build/platform-build-maven-plugin</module>
    <!-- Phase 3 appends: core/platform-core-api, core/platform-core-autoconfigure, core/platform-starter-core -->
    <module>core/platform-core-api</module>
    <module>core/platform-core-autoconfigure</module>
    <module>core/platform-starter-core</module>
    <!-- Phase 4: errors, logging, validation slices. -->
    <module>errors/platform-errors-api</module>
    <module>errors/platform-errors-autoconfigure</module>
    <module>errors/platform-starter-errors</module>
    <module>logging/platform-logging-api</module>
    <module>logging/platform-logging-autoconfigure</module>
    <module>logging/platform-starter-logging</module>
    <module>validation/platform-validation-api</module>
    <module>validation/platform-validation-autoconfigure</module>
    <module>validation/platform-starter-validation</module>
    <!-- Phase 5: observability, openapi slices. -->
    <module>observability/platform-observability-autoconfigure</module>
    <module>observability/platform-starter-observability</module>
    <module>openapi/platform-openapi-autoconfigure</module>
    <module>openapi/platform-starter-openapi</module>
    <!-- Phase 6: restclient, security, authz slices. -->
    <module>restclient/platform-restclient-api</module>
    <module>restclient/platform-restclient-autoconfigure</module>
    <module>restclient/platform-starter-restclient</module>
    <module>security/platform-security-api</module>
    <module>security/platform-security-autoconfigure</module>
    <module>security/platform-starter-security</module>
    <module>security/platform-security-authz-api</module>
    <module>security/platform-security-authz-spi</module>
    <module>security/platform-security-authz-autoconfigure</module>
    <module>security/platform-starter-security-authz</module>
    <!-- Phase 7: messaging (api/spi/inmemory/kafka/rabbit/autoconfigure/starters/test) + events slice. -->
    <module>messaging/platform-messaging-api</module>
    <module>messaging/platform-messaging-spi</module>
    <module>messaging/platform-messaging-inmemory</module>
    <module>messaging/platform-messaging-autoconfigure</module>
    <module>messaging/platform-messaging-kafka</module>
    <module>messaging/platform-messaging-rabbit</module>
    <module>messaging/platform-starter-messaging-inmemory</module>
    <module>messaging/platform-starter-messaging-kafka</module>
    <module>messaging/platform-starter-messaging-rabbit</module>
    <module>messaging/platform-messaging-test</module>
    <module>events/platform-events-api</module>
    <module>events/platform-events-autoconfigure</module>
    <module>events/platform-starter-events</module>
    <module>data/platform-data-api</module>
    <module>data/platform-data-jpa-autoconfigure</module>
    <module>data/platform-starter-data-jpa</module>
    <module>cache/platform-cache-api</module>
    <module>cache/platform-cache-autoconfigure</module>
    <module>cache/platform-starter-cache-caffeine</module>
    <module>cache/platform-starter-cache-redis</module>
    <module>redis/platform-redis-autoconfigure</module>
    <module>redis/platform-starter-redis</module>
    <!-- Phase 9: resilience, locking (jdbc/redis), scheduling, idempotency. -->
    <module>resilience/platform-resilience-api</module>
    <module>resilience/platform-resilience-autoconfigure</module>
    <module>resilience/platform-starter-resilience</module>
    <module>locking/platform-locking-api</module>
    <module>locking/platform-locking-spi</module>
    <module>locking/platform-locking-jdbc</module>
    <module>locking/platform-locking-redis</module>
    <module>locking/platform-locking-autoconfigure</module>
    <module>locking/platform-starter-locking-jdbc</module>
    <module>locking/platform-starter-locking-redis</module>
    <module>scheduling/platform-scheduling-autoconfigure</module>
    <module>scheduling/platform-starter-scheduling</module>
    <module>idempotency/platform-idempotency-api</module>
    <module>idempotency/platform-idempotency-autoconfigure</module>
    <module>idempotency/platform-starter-idempotency</module>

    <module>storage/platform-storage-api</module>
    <module>storage/platform-storage-spi</module>
    <module>storage/platform-storage-fs</module>
    <module>storage/platform-storage-s3</module>
    <module>storage/platform-storage-autoconfigure</module>
    <module>storage/platform-starter-storage-fs</module>
    <module>storage/platform-starter-storage-s3</module>

    <!-- Phase 11: audit (log/jdbc sinks + messaging sink in autoconfigure), ratelimit (inmemory/redis), files. -->
    <module>audit/platform-audit-api</module>
    <module>audit/platform-audit-spi</module>
    <module>audit/platform-audit-log</module>
    <module>audit/platform-audit-jdbc</module>
    <module>audit/platform-audit-autoconfigure</module>
    <module>audit/platform-audit-messaging-autoconfigure</module>
    <module>audit/platform-starter-audit</module>

    <module>ratelimit/platform-ratelimit-api</module>
    <module>ratelimit/platform-ratelimit-spi</module>
    <module>ratelimit/platform-ratelimit-inmemory</module>
    <module>ratelimit/platform-ratelimit-redis</module>
    <module>ratelimit/platform-ratelimit-autoconfigure</module>
    <module>ratelimit/platform-starter-ratelimit</module>

    <module>files/platform-files-api</module>
    <module>files/platform-files-autoconfigure</module>
    <module>files/platform-starter-files</module>

    <module>flags/platform-flags-api</module>
    <module>flags/platform-flags-spi</module>
    <module>flags/platform-flags-inmemory</module>
    <module>flags/platform-flags-openfeature</module>
    <module>flags/platform-flags-autoconfigure</module>
    <module>flags/platform-starter-flags</module>

    <!-- Phase 12: test kit (test-api + starter-test) and provider TCKs. -->
    <module>test/platform-test-api</module>
    <module>test/platform-starter-test</module>
    <module>test/tck/platform-tck-messaging</module>
    <module>test/tck/platform-tck-storage</module>
    <module>test/tck/platform-tck-locking</module>
    <module>test/tck/platform-tck-flags</module>
    <module>test/tck/platform-tck-ratelimit</module>
    <!-- Phase 13: developer experience — the service archetype (upgrade-check + golden-path ship
         inside platform-build-maven-plugin and tooling/scripts respectively). -->
    <module>tooling/platform-service-archetype</module>
    <!-- Phase 15: reference examples. They consume the platform via platform-service-parent exactly as a
         real service does; artifactId prefix "example-" marks them EXAMPLES (enforcer-exempt) and keeps
         them out of the BOM (check-bom) and out of deploy (maven.deploy.skip). -->
    <module>examples/example-minimal</module>
    <!-- Phase 14: documentation as a product. LAST on purpose — its build-time generators read every
         other module's target/ (config metadata, error-codes.csv), so all siblings must build first. -->
    <module>docs/platform-docs</module>
  </modules>

  <build>
    <plugins>
      <!-- flatten resolves ${revision} in installed/deployed POMs (CI-friendly versions).
           Declared on the aggregator so every child that uses the aggregator as parent inherits it.
           platform-service-parent declares its own copy because its parent is spring-boot-starter-parent. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals><goal>flatten</goal></goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals><goal>clean</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Phase 14: opt-in aggregate javadoc for the public surface, published under the docs site at
         docs/site/apidocs. Opt-in (like -Pdocs-site) so the default reactor never depends on the
         javadoc tool; internals carry no guarantee and are excluded. Run:
         mvn -Papidocs -DskipTests javadoc:aggregate -->
    <profile>
      <id>apidocs</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>all,-missing</doclint>
              <excludePackageNames>*.internal:*.internal.*</excludePackageNames>
              <failOnError>false</failOnError>
              <quiet>true</quiet>
              <!-- Emitted inside docs_dir so `mkdocs build` publishes it at the site /apidocs. -->
              <reportOutputDirectory>${project.basedir}/docs</reportOutputDirectory>
              <destDir>apidocs</destDir>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
