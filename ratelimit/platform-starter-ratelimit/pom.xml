<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-starter-ratelimit</artifactId>
  <!-- Starters contain no code (CLAUDE.md rule 4): jar packaging like Boot starters, empty jar. -->
  <packaging>jar</packaging>

  <name>DC Platform :: Rate Limiting :: Starter</name>
  <description>
    Rate limiting backed by the in-memory provider: the ratelimit autoconfigure plus the in-memory
    sliding-window provider. Annotate methods with @RateLimited or inject RateLimiter; enable the
    all-requests filter with dc.platform.ratelimit.http.enabled=true. Add platform-ratelimit-redis and
    a StringRedisTemplate to switch to a cluster-wide Redis limit.
  </description>

  <dependencies>
    <!-- starter -> same-capability autoconfigure + named provider (CLAUDE.md rule 5);
         ratelimit-api/spi arrive transitively. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-ratelimit-autoconfigure</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-ratelimit-inmemory</artifactId>
      <version>${revision}</version>
    </dependency>
  </dependencies>
</project>
