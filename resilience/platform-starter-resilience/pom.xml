<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-starter-resilience</artifactId>
  <!-- Starters contain no code (CLAUDE.md rule 4): jar packaging like Boot starters, empty jar. -->
  <packaging>jar</packaging>

  <name>DC Platform :: Resilience :: Starter</name>
  <description>
    Platform resilience: the resilience autoconfigure plus Resilience4j's Spring Boot 4 integration
    (retry, circuit breaker, time limiter, bulkhead + Micrometer metrics). Contributes the platform's
    default instance tuning; use Resilience4j's @Retry/@CircuitBreaker/@TimeLimiter annotations or the
    RetryableOperation bean.
  </description>

  <dependencies>
    <!-- starter -> same-capability autoconfigure (CLAUDE.md rule 5); resilience-api arrives
         transitively. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-resilience-autoconfigure</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The named provider: Resilience4j's Boot 4 integration supplies the Retry/CircuitBreaker/
         TimeLimiter registries and annotation aspects that the autoconfigure's defaults tune and the
         RetryableOperation bean wires over. Also brings AOP + Micrometer binding. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot4</artifactId>
    </dependency>
  </dependencies>
</project>
