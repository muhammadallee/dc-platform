<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-restclient-autoconfigure</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: REST Client :: Auto Configuration</name>
  <description>
    Auto-configuration for the REST client capability: PlatformRestClientFactory builds
    RestClient.Builder instances on the JDK HttpClient request factory with correlation
    propagation, per-client timeouts, and non-2xx responses mapped to RemoteCallException; an
    optional token-relay customizer activates only when the security capability is present.
  </description>

  <dependencies>
    <!-- autoconfigure -> same-capability api (+ core-api for RequestContext/CapabilityDescriptor). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-restclient-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-core-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- Guarded optional edge to the security capability's api (CLAUDE.md rule 5): the token-relay
         customizer activates only when CurrentUserAccessor is actually registered as a bean
         (@ConditionalOnBean), so this dependency never forces security onto a restclient-only
         consumer. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-security-api</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <!-- JDK HttpClient request-factory builder (ClientHttpRequestFactoryBuilder.jdk()). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-http-client</artifactId>
    </dependency>
    <!-- Reads the bearer token off the JWT principal for the guarded token-relay customizer;
         optional so a restclient-only consumer (no security capability) never needs it. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Generates config metadata from the properties record at compile time. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Runs PlatformArchRules over this module (ArchConstitutionTest). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- MockWebServer asserting headers, timeout config, and error mapping (pinned in
         platform-dependencies; test scope). -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
