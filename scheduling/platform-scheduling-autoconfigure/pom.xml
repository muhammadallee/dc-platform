<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-scheduling-autoconfigure</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: Scheduling :: Auto Configuration</name>
  <description>
    Enables Spring scheduling on a virtual-thread scheduler and ships the @LockedSchedule annotation:
    an AOP advisor runs the annotated method under LockManager.withLock when a LockManager bean is
    present (so a scheduled job runs on one instance cluster-wide), else plainly with a one-time warning.
  </description>

  <dependencies>
    <!-- @API stability marker on public API/SPI types (phase-16 A.1). Compile scope (transitive) so
         the CLASS-retention marker resolves in consumers too; version from platform-dependencies. -->
    <dependency>
      <groupId>org.apiguardian</groupId>
      <artifactId>apiguardian-api</artifactId>
    </dependency>
    <!-- autoconfigure -> core-api for CapabilityDescriptor. -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-core-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- Other capability's api, guarded by @ConditionalOnClass (CLAUDE.md rule 5): the advisor reads
         LockManager ONLY inside a @ConditionalOnClass(LockManager) config, so a scheduling-only
         consumer never loads a locking type (and @LockedSchedule then runs unlocked). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-locking-api</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- Generates config metadata for dc.platform.scheduling.* from the properties record. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Runs PlatformArchRules over this module (ArchConstitutionTest). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The two-context single-execution test wires a real LockManager over the JDBC provider and a
         shared H2 lock table (no Docker). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-locking-autoconfigure</artifactId>
      <version>${revision}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-locking-jdbc</artifactId>
      <version>${revision}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
