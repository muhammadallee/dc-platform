<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-security-api</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: Security :: API</name>
  <description>
    SecurityCustomizer (ordered HttpSecurity extension point), CurrentUser + CurrentUserAccessor
    (the authenticated-principal contract). Depends on spring-security-config because HttpSecurity
    IS the model SecurityCustomizer configures (see README, decision D19).
  </description>

  <!-- Contract artifact: binary-incompatible changes must break the build once a release
       baseline exists (platform-parent wires japicmp; the skip flag flips after 0.1.0). -->
  <properties>
    <platform.japicmp.breakBuild>true</platform.japicmp.breakBuild>
  </properties>

  <dependencies>
    <!-- api -> core-api only (CLAUDE.md rule 5). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-core-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- Sanctioned exception to "no 3rd-party types in api signatures": HttpSecurity is the model
         SecurityCustomizer configures, not an implementation detail (same precedent as errors-api
         / ProblemDetail, decision D11). ArchUnit whitelist admits org.springframework.security
         for this capability only. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-config</artifactId>
    </dependency>
    <!-- Runs PlatformArchRules over this module (ArchConstitutionTest). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
