<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-tck-idempotency</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: TCK :: Idempotency</name>
  <description>
    Technology Compatibility Kit for IdempotencyStore implementations. Extend IdempotencyStoreTck,
    supply a fresh store and a clock hook, and inherit the contract suite (first-wins, duplicate
    rejection, TTL expiry, atomicity under concurrency). A reference in-memory store is certified here
    docker-free; the shipped JDBC store is certified in platform-idempotency-autoconfigure.
  </description>

  <dependencies>
    <!-- The contract under test: IdempotencyStore (an SPI-lite kept in the api, see its javadoc). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-idempotency-api</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>

    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
