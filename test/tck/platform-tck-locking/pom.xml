<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-tck-locking</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: TCK :: Locking</name>
  <description>
    Technology Compatibility Kit for LockProvider providers. Extend LockProviderTck, supply the
    provider, and inherit the full contract suite. The JDBC provider is certified here docker-free on
    H2; the Redis provider certifies under @Tag("docker").
  </description>

  <dependencies>
    <!-- The contract under test: LockProvider (SPI). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-locking-spi</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <!-- Expiry/reacquire is awaited without sleeps. -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
    </dependency>

    <!-- Docker-free certification target: the JDBC provider on H2 (test scope). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-locking-jdbc</artifactId>
      <version>${revision}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
