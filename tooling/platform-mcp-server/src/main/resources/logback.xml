<?xml version="1.0" encoding="UTF-8"?>
<!--
  stdio MCP servers speak JSON-RPC on stdout, so ALL logging must go to stderr — otherwise a log
  line corrupts the protocol stream the client reads. Keep this appender targeted at System.err.
-->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
