<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent is the BARE root aggregator, NOT platform-parent: a maven-archetype generator is neither
       a library nor part of the dependency constitution, so it must escape the enforcer (which forbids
       the literal maven-archetype-plugin version this packaging needs) and the coverage gate. Same
       cycle-avoidance parenting the build/* modules use. -->
  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>dc-platform</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>platform-service-archetype</artifactId>
  <packaging>maven-archetype</packaging>

  <name>DC Platform :: Tooling :: Service Archetype</name>
  <description>
    Maven archetype that generates a ready-to-run platform service: a POM on platform-service-parent
    wired with the golden-path starters (core, errors, logging, validation, observability, openapi,
    security, test) and optional feature slices (messaging, data, restclient via -Dfeatures), a Hello
    controller, profile-aware application.yml (prod fails fast on missing coordinates), platform slice
    tests plus real-HTTP security/logging/data/client tests, a generated PlatformConformanceTest, and
    CLAUDE.md/AGENTS.md so coding agents use platform APIs instead of vanilla Spring. The executable
    contract is tooling/scripts/golden-path.sh (generate -> build -> boot -> probe, every feature combination).
  </description>

  <properties>
    <!-- Versions are legal here (bare-aggregator parent = no enforcer, same as build/* modules). -->
    <maven-archetype-plugin.version>3.4.0</maven-archetype-plugin.version>
    <!-- The archetype integration test forks `mvn verify` on the generated project, which resolves
         platform artifacts from the local repo — a plain reactor `verify` has not installed them yet.
         So it is SKIPPED by default (never breaks the reactor) and enabled by the archetype-it profile.
         golden-path.sh (which installs the platform first) is the real end-to-end gate. -->
    <archetype.test.skip>true</archetype.test.skip>
  </properties>

  <build>
    <!-- Filter ONLY archetype-metadata.xml, so its platformVersion default becomes this archetype's own
         version. The archetype-resources templates must stay unfiltered here: they carry ${groupId},
         ${artifactId}, ${version}... for Velocity at generation time, which Maven filtering would clobber. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>META-INF/maven/archetype-metadata.xml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>META-INF/maven/archetype-metadata.xml</exclude>
        </excludes>
      </resource>
    </resources>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>${maven-archetype-plugin.version}</version>
      </extension>
    </extensions>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-archetype-plugin</artifactId>
          <version>${maven-archetype-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Opt-in, Maven-native (runs on Windows without Bash) check of the archetype itself: generates the
         projects under src/test/resources/projects — basic (every optional property omitted, so the
         metadata defaults are exercised), service (data,restclient) and full (all features, relocated)
         — and runs their goal.txt (`verify`, i.e. every generated test). Requires the platform to be
         installed first (mvn -T1C install -DskipTests). Generated under target/, i.e. inside the checkout;
         the outside-the-reactor, all-combinations, packaged-jar gate is tooling/scripts/golden-path.sh. -->
    <profile>
      <id>archetype-it</id>
      <properties>
        <archetype.test.skip>false</archetype.test.skip>
      </properties>
    </profile>
  </profiles>
</project>
