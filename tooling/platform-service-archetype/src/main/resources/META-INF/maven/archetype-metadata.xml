<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
                      name="platform-service">

  <requiredProperties>
    <!-- Platform version the generated service builds against (its parent + BOM version). The default
         is the archetype's OWN version, stamped in by Maven resource filtering of this file only (see the
         archetype pom), so it can never drift from the train the archetype was released with (ADR-005:
         one version for every platform artifact). Pass -DplatformVersion=<version> to target another. -->
    <requiredProperty key="platformVersion">
      <defaultValue>${project.version}</defaultValue>
    </requiredProperty>
    <!-- Optional feature slices: "none" or a comma-separated subset of {messaging,data,restclient}
         without spaces. Toggles both starter dependencies (pom.xml #if blocks) and sample code/tests
         (Velocity #if in the sample files, which render empty when their feature is off). Tokens are
         matched exactly (",data," in ",<features>,"), never as substrings. Anything else - unknown or
         duplicate tokens, spaces, "none" mixed with features - fails generation from the pom.xml template:
         batch-mode archetype:generate ignores <validationRegex>, so validation cannot live here. The
         default is the literal "none" (not empty): the archetype harness rejects a blank required
         property. -->
    <requiredProperty key="features">
      <defaultValue>none</defaultValue>
    </requiredProperty>
    <!-- Backstage catalog owner (group or user), stamped into catalog-info.yaml. Default keeps
         non-interactive generation working; teams override with -Downer=<team> (phase-16 E). -->
    <requiredProperty key="owner">
      <defaultValue>platform-team</defaultValue>
    </requiredProperty>
    <!-- Not an input: renders the template file __gitignore__ as .gitignore. A literal .gitignore in
         archetype-resources never reaches the archetype jar (default excludes drop it), which is how
         generated services lost theirs. Do not override. -->
    <requiredProperty key="gitignore">
      <defaultValue>.gitignore</defaultValue>
    </requiredProperty>
  </requiredProperties>

  <fileSets>
    <!-- Java sources: relocated under the chosen package and Velocity-filtered. -->
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/main/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/test/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <!-- Resources: filtered, not packaged. The db/migration script is the data sample's schema (Flyway);
         like the Java samples it renders empty when the data feature is off. -->
    <fileSet filtered="true" packaged="false" encoding="UTF-8">
      <directory>src/main/resources</directory>
      <includes>
        <include>**/*.yml</include>
        <include>**/*.sql</include>
      </includes>
    </fileSet>
    <!-- Root docs, copied verbatim (NOT Velocity-filtered: markdown headings use ## which Velocity
         strips as line comments). They ship with the platform's default docs URL and a DC-XX error-code
         placeholder for the team to claim — the same placeholder style as the reference template.
         AGENTS.md mirrors CLAUDE.md for agent tooling that looks for that name. pom.xml is always
         filtered implicitly. -->
    <fileSet filtered="false" packaged="false" encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>README.md</include>
        <include>CLAUDE.md</include>
        <include>AGENTS.md</include>
        <include>__gitignore__</include>
        <!-- MCP client config for agents: static org endpoint + stdio-fallback note, no substitution. -->
        <include>.mcp.json</include>
      </includes>
    </fileSet>
    <!-- catalog-info.yaml IS Velocity-filtered: it interpolates ${artifactId}, ${platformVersion}
         (the dc.platform/train annotation), and ${owner}. It has no ## lines, so filtering is safe. -->
    <fileSet filtered="true" packaged="false" encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>catalog-info.yaml</include>
      </includes>
    </fileSet>
  </fileSets>
</archetype-descriptor>
