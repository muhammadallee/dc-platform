<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ae.gov.dubaicustoms.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../build/platform-parent</relativePath>
  </parent>

  <artifactId>platform-validation-api</artifactId>
  <packaging>jar</packaging>

  <name>DC Platform :: Validation :: API</name>
  <description>
    Common Bean Validation constraints with validators: @NotBlankTrimmed, @Ulid, @SafeText,
    @FutureInstant. Depends on jakarta.validation because constraints must be meta-annotated
    with it (ArchUnit whitelist, decision D11).
  </description>

  <!-- Contract artifact: binary-incompatible changes must break the build once a release
       baseline exists (platform-parent wires japicmp; the skip flag flips after 0.1.0). -->
  <properties>
    <platform.japicmp.breakBuild>true</platform.japicmp.breakBuild>
  </properties>

  <dependencies>
    <!-- @API stability marker on public API/SPI types (phase-16 A.1). Compile scope (transitive) so
         the CLASS-retention marker resolves in consumers too; version from platform-dependencies. -->
    <dependency>
      <groupId>org.apiguardian</groupId>
      <artifactId>apiguardian-api</artifactId>
    </dependency>
    <!-- Sanctioned standard-model dependency: Bean Validation constraints ARE jakarta.validation
         types (@Constraint meta-annotation, ConstraintValidator). Decision D11. -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <!-- Runs PlatformArchRules over this module (ArchConstitutionTest). -->
    <dependency>
      <groupId>ae.gov.dubaicustoms.platform</groupId>
      <artifactId>platform-build-tools</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real validator engine (hibernate + EL) for the per-constraint happy/sad tests. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
